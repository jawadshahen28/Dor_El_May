{
  "name": "door-el-may-talfit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace client",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "db:check": "npm run db:check --workspace server",
    "admin:create": "npm run admin:create --workspace server",
    "setup:env": "node scripts/setup-env.mjs",
    "test": "node --test shared/test/*.test.js server/test/*.test.js",
    "test:db": "node --test --test-concurrency=1 server/test/integration/*.test.js",
    "test:production": "npm run build && node --test --test-concurrency=1 server/test/production/*.test.js",
    "test:ui": "npm run build && node scripts/run-browser-tests.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  }
}
